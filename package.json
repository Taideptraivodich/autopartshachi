{
  "name": "autoparts-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=packages/api",
    "build": "npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=packages/db",
    "db:migrate": "npm run db:migrate --workspace=packages/db",
    "db:seed": "npm run db:seed --workspace=packages/db",
    "db:reset": "npm run db:reset --workspace=packages/db",
    "db:studio": "npm run db:studio --workspace=packages/db",
    "typecheck": "npm run typecheck --workspace=packages/db && tsc -b --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web"
  },
  "engines": {
    "node": ">=18"
  }
}
