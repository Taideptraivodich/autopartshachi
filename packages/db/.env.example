# PostgreSQL connection string used by both the app (src/db/index.ts)
# and drizzle-kit (drizzle.config.ts).
#
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autoparts

# Optional: cap the pg Pool size (defaults to 10 in src/db/index.ts)
DB_POOL_MAX=10
